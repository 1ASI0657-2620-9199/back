      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "const data = pm.response.json();",
              "if (pm.response.code !== 200 && Number(pm.variables.get(\"polls\") || 0) < 30) {",
              "  pm.variables.set(\"polls\", Number(pm.variables.get(\"polls\") || 0) + 1);",
              "  pm.execution.setNextRequest(pm.info.requestId);",
              "} else {",
              "  pm.variables.set(\"polls\", 0);",
              "  pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "  pm.test(\"Reserva para ahorro\", () => pm.expect(Number(data.savings_target)).to.eql(400));",
              "  pm.test(\"Distribuye 1600\", () => pm.expect(data.budgets.reduce((sum, b) => sum + Number(b.limit_amount), 0)).to.eql(1600));",
              "}",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Guardar preferencias",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/notification-preferences",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"budget_enabled\": false,\n  \"device_enabled\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Preferencias\", () => pm.expect(pm.response.json().budget_enabled).to.eql(false));",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "24 OpenAPI de cada servicio",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          }
        ],
        "url": "{{baseUrl}}/services/devices/openapi.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Contrato de telemetría\", () => pm.expect(pm.response.json().paths).to.have.property(\"/api/v1/devices/{device_id}/readings\"));",
              "})();"
            ]
          }
        }
      ]
    }
  ]
