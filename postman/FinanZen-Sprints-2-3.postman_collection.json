      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "pm.test(\"HTTP 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Lectura persistida\", () => pm.expect(pm.response.json().read_at).to.be.a(\"string\"));",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Crear medidor simulado",
