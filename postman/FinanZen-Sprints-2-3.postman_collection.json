          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/devices",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Medidor Postman\",\n  \"monthly_limit_kwh\": \"20\",\n  \"tariff_per_kwh\": \"0.75\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
