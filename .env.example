# The local suite creates four SQLite files under this directory.
FINANZEN_DATA_DIR=data
# Optional frontend checkout when front/ is not beside back/.
# FINANZEN_FRONTEND_PATH=C:/projects/FinanZen/front
#
# Optional PostgreSQL connections. Each service MUST own a distinct database.
# Never reuse the financial database for another service.
# DATABASE_URL=postgresql://...
# BUDGET_DATABASE_URL=postgresql://...
# NOTIFICATION_DATABASE_URL=postgresql://...
# TELEMETRY_DATABASE_URL=postgresql://...
#
# Optional secret for /services/{name}/internal/events over HTTP.
# Disabled if unset. The local dispatcher does not need it.
# FINANZEN_INTERNAL_EVENT_KEY=generate-a-private-value
#
# Compose automatically loads .env; the direct Python launcher does not.
# Container port and checkout overrides:
WEB_PORT=8080
KAFKA_PORT=9092
FRONTEND_CONTEXT=../front
# Kafka is enabled inside Compose. Direct local development keeps it disabled.
# EVENT_TRANSPORT=kafka
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# Controlled provider outage for testing only (default: 0):
FINANZEN_NOTIFICATION_SIMULATE_FAILURE=0
